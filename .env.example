# ==============================================================================
# Go 棋牌游戏大厅全栈单体服务环境配置文件 (.env)
# ==============================================================================

# 基础端口与服务配置
HTTP_PORT=8080
GRPC_PORT=50051
WORKER_POOL_COUNT=64
HOUSE_RAKE_RATE=0.05

# Redis 内存状态服务配置
REDIS_ADDR=127.0.0.1:6379
REDIS_PASS=

# ==============================================================================
# Telegram Bot 管理员监控与指令系统配置
# ==============================================================================
# 从 Telegram 官方 @BotFather 申请获得的 Bot Token
TELEGRAM_BOT_TOKEN=

# 管理员的 Telegram 用户数字 ID (可从 @userinfobot 或 @myidbot 查询)
TELEGRAM_ADMIN_ID=

# ==============================================================================
# Cloudflare Tunnel 穿透隧道配置 (主要用于 Termux 与 Linux 公网访问)
# ==============================================================================
# Cloudflare Zero Trust 面板生成的隧道 Token (留空则使用临时快速隧道 Quick Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=

# 大陆地区优化 DNS (避免 1.1.1.1 和 8.8.8.8 被封锁阻断，使用阿里与腾讯公共DNS)
CLOUDFLARE_DNS=223.5.5.5,119.29.29.29

# 强制使用 IPv4 连接 (Termux 手机移动网络多数不支持 IPv6，强制 IPv4 避免握手卡死)
CLOUDFLARE_EDGE_IP_VERSION=4
